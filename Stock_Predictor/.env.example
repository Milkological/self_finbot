# ============================================================
# .env.example — FinBot environment configuration template
#
# HOW TO USE:
#   1. Copy this file:   copy .env.example .env
#   2. Fill in your real values in .env
#   3. Never commit .env to git (it contains secrets)
# ============================================================

# ----------------------------------------------------------
# Azure OpenAI credentials
# Get these from: Azure Portal → Azure OpenAI resource → Keys and Endpoint
# ----------------------------------------------------------

# Your API key (either Key1 or Key2 from the Azure Portal)
AZURE_OPENAI_KEY=your-azure-openai-key-here

# The endpoint URL for your Azure OpenAI resource
# Format: https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# The name you gave your model deployment in Azure OpenAI Studio
# (This is NOT the model name like "gpt-4o" — it is the custom deployment name you chose)
# Find it at: Azure OpenAI Studio → Deployments
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Azure OpenAI REST API version
# Recommended: 2024-12-01-preview
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ----------------------------------------------------------
# Google Gemini credentials (alternative / supplementary to Azure)
# Get a free API key from: https://aistudio.google.com/app/apikey
# If BOTH Azure and Google are configured, FinBot calls both and
# synthesises a consensus recommendation automatically.
# ----------------------------------------------------------

# Your Google AI Studio API key
GOOGLE_API_KEY=""

# Gemini model to use
# Options: gemini-2.0-flash (recommended), gemini-2.0-flash-lite (fastest/cheapest)
GOOGLE_MODEL=gemini-2.0-flash

# ----------------------------------------------------------
# Optional overrides (safe to leave commented out)
# ----------------------------------------------------------

# Risk-free rate used in the Sharpe Ratio formula (annualised decimal).
# Default: 0.0525 = 5.25% (approximate US 3-month T-Bill yield)
# Uncomment and change if you want a different rate:
# RISK_FREE_RATE=0.0525
