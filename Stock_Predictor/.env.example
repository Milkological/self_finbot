# ============================================================
# .env.example — FinBot environment configuration template
#
# HOW TO USE:
#   1. Copy this file:   copy .env.example .env
#   2. Fill in your real values in .env
#   3. Never commit .env to git (it contains secrets)
# ============================================================

# ----------------------------------------------------------
# Azure OpenAI credentials
# Get these from: Azure Portal → Azure OpenAI resource → Keys and Endpoint
# ----------------------------------------------------------

# Your API key (either Key1 or Key2 from the Azure Portal)
AZURE_OPENAI_KEY=your-azure-openai-key-here

# The endpoint URL for your Azure OpenAI resource
# Format: https://<your-resource-name>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# The name you gave your model deployment in Azure OpenAI Studio
# (This is NOT the model name like "gpt-4o" — it is the custom deployment name you chose)
# Find it at: Azure OpenAI Studio → Deployments
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Azure OpenAI REST API version
# Recommended: 2024-12-01-preview
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ----------------------------------------------------------
# Google Gemini credentials (alternative / supplementary to Azure)
# Get a free API key from: https://aistudio.google.com/app/apikey
# If BOTH Azure and Google are configured, FinBot calls both and
# synthesises a consensus recommendation automatically.
# ----------------------------------------------------------

# Your Google AI Studio API key
GOOGLE_API_KEY=""

# Gemini model to use
# Options: gemini-2.0-flash (recommended), gemini-2.0-flash-lite (fastest/cheapest)
GOOGLE_MODEL=gemini-2.0-flash

# ----------------------------------------------------------
# DeepSeek credentials (optional — skipped when key is absent)
# Get your key from: https://platform.deepseek.com/api_keys
# If configured alongside Azure/Google, all three providers run independently.
# ----------------------------------------------------------

DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Model to use (optional, default: deepseek-chat)
# Options: deepseek-chat, deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat

# ----------------------------------------------------------
# SEC EDGAR contact (optional — fundamentals are skipped when absent)
# SEC's fair-access policy requires a contact email in the User-Agent;
# requests without one get 403s. No signup or key needed.
# ----------------------------------------------------------

SEC_EDGAR_CONTACT=you@example.com

# ----------------------------------------------------------
# Optional overrides (safe to leave commented out)
# ----------------------------------------------------------

# Risk-free rate used in the Sharpe Ratio formula (annualised decimal).
# Default: 0.0525 = 5.25% (approximate US 3-month T-Bill yield)
# Uncomment and change if you want a different rate:
# RISK_FREE_RATE=0.0525

# ----------------------------------------------------------
# LLM resilience (safe to leave commented — sensible defaults apply)
# Controls how a slow/unreachable provider is handled. A per-provider
# circuit breaker + automatic rule-based fallback mean a dead provider
# costs seconds, not minutes. Run `python main.py --doctor` to check
# provider reachability.
# ----------------------------------------------------------

# Per-request timeout in seconds (SDK default was 600 — far too long).
# 60 leaves headroom for legitimate slow generations.
# LLM_TIMEOUT=60

# Per-request retries. 0 = fail fast; the circuit breaker + rule-based
# fallback already provide resilience, so retries just double the wait
# on an unreachable provider. Raise to 1 for flaky single-agent blips.
# LLM_MAX_RETRIES=0

# Consecutive connection failures before a provider is skipped for the
# rest of the run (its remaining agents fall back instead of hanging).
# LLM_CIRCUIT_THRESHOLD=2
