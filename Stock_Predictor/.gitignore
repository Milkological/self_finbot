# ===========================================================================
# FinBot — .gitignore
# ===========================================================================
# Each section explains WHY those paths must stay out of version control.
# ===========================================================================


# ---------------------------------------------------------------------------
# Python bytecode & interpreter caches
# ---------------------------------------------------------------------------
# Python compiles .py files to bytecode for faster re-execution. These
# .pyc / .pyo files are machine-specific and are regenerated automatically,
# so there is no value in committing them — they only create merge conflicts.
__pycache__/
*.py[cod]
*$py.class
*.pyo


# ---------------------------------------------------------------------------
# Distribution / packaging artefacts
# ---------------------------------------------------------------------------
# Generated by setuptools / build backends. Never commit build artefacts
# because they embed absolute paths and platform-specific binaries.
*.egg
*.egg-info/
dist/
build/
.eggs/
MANIFEST


# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
# finbot_venv/ is the project-local virtualenv (created by the developer).
# It contains platform-specific compiled extensions (~200 MB) that should
# never be pushed — collaborators create their own env from requirements.txt.
finbot_venv/
venv/
.venv/
env/
ENV/


# ---------------------------------------------------------------------------
# Secrets & environment variables
# ---------------------------------------------------------------------------
# .env holds live API keys for Azure OpenAI and Google Gemini.
# Committing credentials is a critical security vulnerability (OWASP A02).
# Use .env.example (no real keys) to document required variables instead.
.env
.env.*
!.env.example


# ---------------------------------------------------------------------------
# Generated output (created fresh on every run)
# ---------------------------------------------------------------------------
# reports/ is populated at runtime with per-ticker artefacts:
#   • Markdown report  (.md)
#   • PNG charts       (.png)
#   • PDF report       (.pdf)
#   • features CSV     (.csv)
# These are outputs, not source — committing them inflates repo size and
# creates noisy diffs that obscure real code changes.
reports/


# ---------------------------------------------------------------------------
# Trained ML model files
# ---------------------------------------------------------------------------
# .pkl files are binary-serialised scikit-learn GradientBoosting models.
# They are regenerated via `python main.py --retrain` and are large (~MB).
# features.json and metrics.json are derived artefacts alongside each model.
# Individual ticker sub-directories are created automatically by trainer.py.
models/**/*.pkl
models/**/features.json
models/**/metrics.json


# ---------------------------------------------------------------------------
# IDE & editor artefacts
# ---------------------------------------------------------------------------
# These are personal workspace preferences — they differ per developer and
# should not be imposed on the whole team via version control.
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db


# ---------------------------------------------------------------------------
# Test & coverage output
# ---------------------------------------------------------------------------
# pytest generates .pytest_cache/ for test discovery speed-ups.
# coverage.xml / htmlcov/ are HTML coverage reports — useful locally but
# not part of the source tree.
.pytest_cache/
htmlcov/
.coverage
coverage.xml
*.cover


# ---------------------------------------------------------------------------
# Log files
# ---------------------------------------------------------------------------
# Any *.log files written by the logging module at runtime.
*.log


# ---------------------------------------------------------------------------
# PYC files in __pycache__ directories
# ---------------------------------------------------------------------------
# Any *.pyc files written by the Python interpreter at runtime.
*.pyc


