# .env.example
# Copy this file to a new file named exactly ".env" and fill in your Reddit API credentials.
# NEVER commit the real .env file to source control — keep it local only.
#
# How to get these values:
#   1. Log into Reddit at https://www.reddit.com
#   2. Go to https://www.reddit.com/prefs/apps
#   3. Click "Create Another App" at the bottom
#   4. Choose type: "script"
#   5. Name: anything you like (e.g. stock_scraper)
#   6. Redirect URI: http://localhost:8080
#   7. Click "Create app"
#   8. client_id  = the string shown directly UNDER your app name (short alphanumeric)
#   9. client_secret = the "secret" field
#  10. user_agent = any descriptive string, convention is "platform:app_name:version (by /u/YourUsername)"

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=script:stock_scraper:v1.0 (by /u/your_reddit_username)
